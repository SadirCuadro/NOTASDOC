<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/etiTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="::CRUD Universidades::"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/etiId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etiTitulo"
        android:layout_marginTop="16dp"
        android:text="ID:" />

    <EditText
        android:id="@+id/campoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etiId"
        android:inputType="numberSigned"
        android:enabled="false" />

    <TextView
        android:id="@+id/etiNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campoId"
        android:layout_marginTop="8dp"
        android:text="Nombre:" />

    <EditText
        android:id="@+id/campoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etiNombre"
        android:inputType="textCapWords" />

    <TextView
        android:id="@+id/etiWww"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campoNombre"
        android:layout_marginTop="8dp"
        android:text="Www:" />

    <EditText
        android:id="@+id/campoWww"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etiWww"
        android:inputType="textUri" />

    <Button
        android:id="@+id/botonGuardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campoWww"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:text="Guardar"
        android:onClick="agregarUniversidad" />

    <Button
        android:id="@+id/botonLimpiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campoWww"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Limpiar"
        android:onClick="limpiarCampos" />

    <Button
        android:id="@+id/botonBuscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campoWww"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:text="Buscar"
        android:onClick="mostrarCuadroDialogoId" />

</RelativeLayout>
